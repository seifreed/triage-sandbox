# Select the deployment used by the CLI and library helpers.
# Use `public`, `private`, or both (`public,private`).
TRIAGE_INSTANCE=public

# Public Triage
TRIAGE_PUBLIC_TOKEN=YOUR_PUBLIC_API_TOKEN_HERE
TRIAGE_PUBLIC_API_URL=https://api.tria.ge

# Private Triage
TRIAGE_PRIVATE_TOKEN=YOUR_PRIVATE_API_TOKEN_HERE
TRIAGE_PRIVATE_API_URL=https://private.tria.ge/api
